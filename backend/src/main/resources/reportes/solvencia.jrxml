<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="Solvencia_CodeNSchool" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    
    <parameter name="ID_ESTUDIANTE" class="java.lang.Integer"/>
    <parameter name="ID_CICLO" class="java.lang.Integer"/>
    
    <queryString language="sql">
        <![CDATA[
        SELECT e.codigo_personal, e.nombres, e.apellidos, g.nombre AS grado, c.anio AS ciclo
        FROM estudiante e
        INNER JOIN inscripcion i ON e.id_estudiante = i.id_estudiante
        INNER JOIN grado g ON i.id_grado = g.id_grado
        INNER JOIN ciclo_lectivo c ON i.id_ciclo = c.id_ciclo
        WHERE e.id_estudiante = $P{ID_ESTUDIANTE} AND c.id_ciclo = $P{ID_CICLO}
        ]]>
    </queryString>
    
    <field name="codigo_personal" class="java.lang.String"/>
    <field name="nombres" class="java.lang.String"/>
    <field name="apellidos" class="java.lang.String"/>
    <field name="grado" class="java.lang.String"/>
    <field name="ciclo" class="java.lang.Integer"/>
    
    <title>
        <band height="72">
            <frame>
                <reportElement mode="Opaque" x="-20" y="-20" width="595" height="92" backcolor="#006699"/>
                <staticText>
                    <reportElement x="20" y="20" width="279" height="43" forecolor="#FFFFFF"/>
                    <textElement>
                        <font size="34" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Code_n_School]]></text>
                </staticText>
                <staticText>
                    <reportElement x="350" y="43" width="225" height="20" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right">
                        <font size="14" isBold="false"/>
                    </textElement>
                    <text><![CDATA[Constancia de Solvencia]]></text>
                </staticText>
            </frame>
        </band>
    </title>
    
    <pageHeader>
        <band height="40"/>
    </pageHeader>
    
    <detail>
        <band height="250">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30" forecolor="#333333"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[A QUIEN INTERESE:]]></text>
            </staticText>
            
            <textField textAdjust="StretchHeight">
                <reportElement x="40" y="50" width="475" height="80"/>
                <textElement textAlignment="Justified" markup="html">
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["Por este medio se hace constar que el estudiante <b>" + $F{nombres} + " " + $F{apellidos} + "</b>, con código personal <b>" + $F{codigo_personal} + "</b>, inscrito en el grado de <b>" + $F{grado} + "</b>, se encuentra completamente <b>SOLVENTE</b> en sus pagos de colegiaturas, inscripciones y obligaciones de biblioteca para el ciclo lectivo <b>" + $F{ciclo} + "</b>."]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="40" y="150" width="475" height="30"/>
                <textElement textAlignment="Justified">
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["Y para los usos legales que al interesado convengan, se extiende la presente constancia con fecha: " + new java.text.SimpleDateFormat("dd 'de' MMMM 'de' yyyy", new java.util.Locale("es", "ES")).format(new java.util.Date()) + "."]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="177" y="220" width="200" height="20"/>
                <box>
                    <topPen lineWidth="1.0" lineColor="#000000"/>
                </box>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Firma de Tesorería]]></text>
            </staticText>
        </band>
    </detail>
</jasperReport>